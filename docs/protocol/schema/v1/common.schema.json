{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blob-royale.invalid/protocol/v1/common.schema.json",
  "title": "Blob Royale protocol v1 common definitions",
  "description": "Canonical scalar, vector, metadata, and error definitions shared by protocol v1 messages.",
  "x-status": "Accepted",
  "$defs": {
    "protocol_version": {
      "type": "string",
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "schema_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^blob-royale://protocol/v1/[a-z][a-z0-9-]*$"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 32,
      "pattern": "Z$"
    },
    "safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "finite_world_scalar": {
      "type": "number",
      "minimum": -1000000000000,
      "maximum": 1000000000000
    },
    "vector2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "$ref": "#/$defs/finite_world_scalar"
        },
        "y": {
          "$ref": "#/$defs/finite_world_scalar"
        }
      }
    },
    "error_details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["GET"]
          }
        },
        "expected_websocket_version": {
          "type": "string",
          "const": "13"
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "PROTOCOL.CONNECTION_LIMIT_REACHED",
            "PROTOCOL.HEADER_TOO_LARGE",
            "PROTOCOL.INVALID_REQUEST",
            "PROTOCOL.INVALID_REQUEST_ID",
            "PROTOCOL.METHOD_NOT_ALLOWED",
            "PROTOCOL.ORIGIN_REJECTED",
            "PROTOCOL.PAYLOAD_TOO_LARGE",
            "PROTOCOL.RATE_LIMITED",
            "PROTOCOL.ROUTE_NOT_FOUND",
            "PROTOCOL.SUBPROTOCOL_REQUIRED",
            "PROTOCOL.UPGRADE_REQUIRED",
            "PROTOCOL.WEBSOCKET_VERSION_UNSUPPORTED",
            "SERVICE.INTERNAL_FAILURE",
            "SERVICE.NOT_READY"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "$ref": "#/$defs/error_details"
        }
      }
    }
  }
}
