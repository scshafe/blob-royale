{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blob-royale.invalid/protocol/v1/readiness-response.schema.json",
  "title": "Blob Royale protocol v1 readiness response",
  "description": "Successful GET /api/v1/health/ready response envelope. A non-ready service uses error-response.schema.json.",
  "x-status": "Accepted",
  "type": "object",
  "additionalProperties": false,
  "required": ["data", "error", "meta"],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "snapshot_available"],
      "properties": {
        "status": {
          "type": "string",
          "const": "ready"
        },
        "snapshot_available": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "error": {
      "type": "null"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "schema_id", "request_id"],
      "properties": {
        "protocol_version": {
          "$ref": "common.schema.json#/$defs/protocol_version"
        },
        "schema_id": {
          "const": "blob-royale://protocol/v1/readiness-response"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/request_id"
        }
      }
    }
  }
}
