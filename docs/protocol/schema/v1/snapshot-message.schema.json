{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blob-royale.invalid/protocol/v1/snapshot-message.schema.json",
  "title": "Blob Royale protocol v1 WebSocket snapshot message",
  "description": "The only application data message sent after a successful snapshot WebSocket upgrade.",
  "x-status": "Accepted",
  "type": "object",
  "additionalProperties": false,
  "required": ["data", "error", "meta"],
  "properties": {
    "data": {
      "$ref": "snapshot-data.schema.json"
    },
    "error": {
      "type": "null"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "schema_id", "request_id", "message_sequence", "sent_at_utc"],
      "properties": {
        "protocol_version": {
          "$ref": "common.schema.json#/$defs/protocol_version"
        },
        "schema_id": {
          "const": "blob-royale://protocol/v1/snapshot-message"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/request_id"
        },
        "message_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sent_at_utc": {
          "$ref": "common.schema.json#/$defs/utc_timestamp"
        }
      }
    }
  }
}
