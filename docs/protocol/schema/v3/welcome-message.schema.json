{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blob-royale.invalid/protocol/v3/welcome-message.schema.json",
  "title": "Blob Royale protocol v3 WebSocket welcome message",
  "description": "The first and only welcome frame of a session. It is always message_sequence 1, so a client that receives a snapshot first has lost a frame and must close.",
  "x-status": "Accepted",
  "type": "object",
  "additionalProperties": false,
  "required": ["data", "error", "meta"],
  "properties": {
    "data": {
      "$ref": "welcome-data.schema.json"
    },
    "error": {
      "type": "null"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "schema_id", "request_id", "message_sequence", "sent_at_utc"],
      "properties": {
        "protocol_version": {
          "$ref": "common.schema.json#/$defs/protocol_version"
        },
        "schema_id": {
          "const": "blob-royale://protocol/v3/welcome-message"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/request_id"
        },
        "message_sequence": {
          "type": "integer",
          "const": 1
        },
        "sent_at_utc": {
          "$ref": "common.schema.json#/$defs/utc_timestamp"
        }
      }
    }
  }
}
