#!/usr/bin/env bash

# Reports the exact Linux toolchain facts used by build and release evidence.
# Inputs: none. Side effects: none. Idempotent: yes.

set -euo pipefail

readonly EXPECTED_ARCHITECTURE=x86_64
readonly EXPECTED_BASE_IMAGE_DIGEST=sha256:019e8eb29a85e74d64925745884f2ec79aa27e3feab36353d24656f4d6b89467
readonly EXPECTED_TOOLCHAIN_ID=ubuntu-24.04-amd64-20260804

if [[ "$(uname -s)" != "Linux" ]]; then
  printf 'report-toolchain: Linux is required\n' >&2
  exit 69
fi

if [[ "$(uname -m)" != "${EXPECTED_ARCHITECTURE}" ]]; then
  printf 'report-toolchain: expected architecture %s, received %s\n' \
    "${EXPECTED_ARCHITECTURE}" "$(uname -m)" >&2
  exit 69
fi

for required_command in cmake g++ clang++ clang-format clang-tidy git grype ld ldd ninja node npm syft; do
  if ! command -v "${required_command}" >/dev/null 2>&1; then
    printf 'report-toolchain: required command is missing: %s\n' "${required_command}" >&2
    exit 69
  fi
done

# The pinned Linux image always supplies this standard distribution metadata file.
# shellcheck disable=SC1091
DISTRIBUTION="$(. /etc/os-release && printf '%s' "${PRETTY_NAME}")"
readonly DISTRIBUTION
BOOST_VERSION="$(dpkg-query --show --showformat='${Version}' libboost-json-dev)"
readonly BOOST_VERSION
NPM_VERSION="$(npm --version)"
readonly NPM_VERSION
readonly CATCH2_SOURCE_DIRECTORY=/opt/blob-royale-deps/catch2

if [[ -z "${NPM_VERSION}" ]]; then
  printf 'report-toolchain: npm returned an empty version\n' >&2
  exit 69
fi

for catch2_metadata_file in \
  .blob-royale-source-version \
  .blob-royale-source-commit \
  .blob-royale-source-sha256; do
  if [[ ! -r "${CATCH2_SOURCE_DIRECTORY}/${catch2_metadata_file}" ]]; then
    printf 'report-toolchain: Catch2 metadata is missing: %s\n' \
      "${CATCH2_SOURCE_DIRECTORY}/${catch2_metadata_file}" >&2
    exit 69
  fi
done

printf 'toolchain_id=%s\n' "${BLOB_ROYALE_TOOLCHAIN_ID:-${EXPECTED_TOOLCHAIN_ID}}"
printf 'base_image_digest=%s\n' "${BLOB_ROYALE_BASE_IMAGE_DIGEST:-${EXPECTED_BASE_IMAGE_DIGEST}}"
printf 'kernel=%s\n' "$(uname -sr)"
printf 'architecture=%s\n' "$(uname -m)"
printf 'distribution=%s\n' "${DISTRIBUTION}"
printf 'glibc=%s\n' "$(ldd --version | sed -n '1p')"
printf 'gcc=%s\n' "$(g++ --version | sed -n '1p')"
printf 'clang=%s\n' "$(clang++ --version | sed -n '1p')"
printf 'clang_format=%s\n' "$(clang-format --version | sed -n '1p')"
printf 'clang_tidy=%s\n' "$(clang-tidy --version | sed -n '1p')"
printf 'linker=%s\n' "$(ld --version | sed -n '1p')"
printf 'cmake=%s\n' "$(cmake --version | sed -n '1p')"
printf 'ninja=%s\n' "$(ninja --version)"
printf 'git=%s\n' "$(git --version)"
printf 'boost=%s\n' "${BOOST_VERSION}"
printf 'catch2=%s\n' "$(<"${CATCH2_SOURCE_DIRECTORY}/.blob-royale-source-version")"
printf 'catch2_commit=%s\n' "$(<"${CATCH2_SOURCE_DIRECTORY}/.blob-royale-source-commit")"
printf 'catch2_archive_sha256=%s\n' \
  "$(<"${CATCH2_SOURCE_DIRECTORY}/.blob-royale-source-sha256")"
printf 'node=%s\n' "$(node --version)"
printf 'npm=%s\n' "${NPM_VERSION}"
printf 'syft=%s\n' "$(syft version | sed -nE 's/^Version:[[:space:]]*//p')"
printf 'grype=%s\n' "$(grype version | sed -nE 's/^Version:[[:space:]]*//p')"
